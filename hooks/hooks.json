{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/gate_hook.py"],
            "timeout": 45,
            "onFailure": "block",
            "statusMessage": "agent-safeguard-gate: checking action"
          }
        ]
      }
    ]
  }
}
